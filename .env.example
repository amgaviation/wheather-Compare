PORT=8787
# Supabase project used as the data store — run supabase/schema.sql against it once, then set
# these to the project's URL and anon (publishable) key. This key is a server-side secret in
# this app (RLS scopes it to just the wxc_* tables): never expose it to a browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
DEFAULT_STATIONS=KTEB,KHPN,KVNY
BACKFILL_DAYS=120
USE_OPEN_METEO=true
WX_USER_AGENT=wx-compare/0.1 (your-email@example.com)
# Vercel deployment only: protects the api/cron/* endpoints from being triggered by anyone who
# finds the URL. Vercel automatically sends this as a bearer token when it invokes a Cron Job
# itself, once the env var is set on the project.
CRON_SECRET=
